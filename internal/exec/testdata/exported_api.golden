type Arg struct{reveal func() string; kind argKind}
type BoundedOutput struct{buf *outputBuf; overflow bool; forced bool}
type Call struct{Name string; Args []string; Interactive bool; Input string; Env map[string]string; UnsetEnv []string}
type CaptureMode uint8
type CommandError struct{Name string; Args []string; Stderr string; StderrDropped int64; Output string; ExitCode int; Err error; span opaqueSpan}
type CommandKind uint8
type DiscardingRunner interface{RunDiscardingStdout(ctx context.Context, name string, args ...string) error}
type EnvMutation struct{key string; value SecretArg; op envOp}
type FakeRunner struct{RunFunc func(name string, args []string) (string, error); InteractiveErr error; mu sync.Mutex; Calls []Call}
type FakeSensitiveRunner struct{RunFunc func(cmd SensitiveCommand) (SensitiveResult, error); mu sync.Mutex; calls []SensitiveCommand}
type OSRunner struct{stdoutCeiling int}
type OSSensitiveRunner struct{env []string; retireBound time.Duration; killDrainBound time.Duration; started sync/atomic.Int64; stdoutTap func(io.Reader) io.Reader}
type Outcome uint8
type OutputCause uint8
type Runner interface{Run(ctx context.Context, name string, args ...string) (string, error); RunInteractive(ctx context.Context, name string, args ...string) error; RunWithEnv(ctx context.Context, env map[string]string, name string, args ...string) (string, error); RunWithEnvFiltered(ctx context.Context, env map[string]string, unset []string, name string, args ...string) (string, error); RunWithInput(ctx context.Context, stdin string, name string, args ...string) (string, error)}
type SecretArg struct{reveal func() string}
type SensitiveCommand struct{Kind CommandKind; Path SecretArg; Args []Arg; Env []EnvMutation; StdoutMode CaptureMode; StdoutCap int64; StderrCap int64}
type SensitiveError struct{Kind CommandKind; Outcome Outcome; ExitCode int; StdoutBytes int; StderrBytes int; reason string}
type SensitiveResult struct{Stdout BoundedOutput; Stderr BoundedOutput; ExitCode int}
type SensitiveRunner interface{RunSensitive(ctx context.Context, cmd SensitiveCommand) (SensitiveResult, error)}
type StreamingRunner interface{RunStreaming(ctx context.Context, stdin io.Reader, stdout io.Writer, stderr io.Writer, name string, args ...string) error}
type Transform struct{apply func(string) string}
type argKind uint8
type argMask struct{shown map[string]string; pats []maskPat; values []string; entries []string}
type bitset []uint64
type ceilingWriter struct{limit int; discard bool; buf []byte; over bool; proc func() *os.Process}
type constantArg string
type copyJob struct{dst io.Writer; src *onceCloser}
type copyResult struct{stdin bool; err error}
type envOp uint8
type maskKey struct{}
type maskPat struct{text string; shown string}
type onceCloser struct{*os.File; once sync.Once}
type opaqueKey struct{}
type opaqueSpan struct{from int; n int}
type outputBuf struct{data []byte}
type projectedCmuxWorkspace struct{ID string "json:\"id\""; Description string "json:\"description\""}
type streamPipes struct{childEnds []*os.File; readEnds []*onceCloser; stdinW *onceCloser; outputs []copyJob; stdin io.Reader; results chan copyResult; nOut int; nIn int}
type tailBuffer struct{limit int; buf []byte; dropped int64}
var ErrCanceled error
var ErrInvalidCommand error
var ErrNonzeroExit error
var ErrOutputLimit error
var ErrOutputTooLarge error
var ErrStartFailed error
var ErrTimeout error
