<!doctype html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>{{if .DocTitle}}{{.DocTitle}} · {{end}}forgectl docs</title>
<link rel="stylesheet" href="/assets/artificer.css"/>
<link rel="stylesheet" href="/assets/chroma.css"/>
<link rel="stylesheet" href="/assets/diagram.css"/>
<link rel="stylesheet" href="/assets/katex/katex.min.css"/>
<style>
/* ═══ Docs reader shell — ported from the design reference (shell-reference.html,
   docs/plans/2026-09-01-docs-reader-v2.md). Template-owned, not vendored.
   Inline <style> is fine under the CSP (style-src carries 'unsafe-inline'). ═══ */
html { background: var(--bg); }
body { margin: 0; background: var(--bg); color: var(--fg); font-family: var(--font-interface, sans-serif); }
a { color: var(--accent); } a:hover { color: var(--accent-bright); }

/* ── tree--static backing (candidate to upstream) ── */
.tree--static details[open] > summary > .tree__twisty { transform: rotate(90deg); }
.tree--static summary > .count {
  margin-left: auto; font-variant-numeric: tabular-nums;
  font-size: var(--t-label-sm-size); color: var(--fg-secondary);
}

/* ── Tree density: 24px verdict (beats .sidenav a's 44px floor) ── */
.sidenav .tree__row { min-height: 24px; font-size: 13px; }
.sidenav a.tree__row { min-height: 24px; }
.sidenav > a { min-height: 24px; font-size: 13px; }
.sidenav > a, .sidenav > .sidenav__group, .sidenav > ul { flex: none; }
/* One row box for files and folders. A file row is an <a>, so it also picks
   up .sidenav a's 6px 10px padding, which pushed every file a few pixels
   right of the folder rows beside it. */
.sidenav .tree__row, .sidenav > a { padding: 2px var(--s-sm); }
/* One line per row. Titles are a doc's whole h1, and a long one wrapped to
   five lines; the full title is in the row's title attribute. */
.sidenav .label { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* ── Note typography for the document pane ── */
main.surface-document { max-width: 820px; }
.doc-body { font-size: 16px; line-height: 1.65; }
/* Headings are --fg, not --accent: in Artificer the gold means "you can
   click this", so gold headings read as links next to the real ones. */
.doc-body h1, .doc-body h2, .doc-body h3, .doc-body h4 {
  font-family: var(--font-mono); font-weight: 700; letter-spacing: -0.01em;
  color: var(--fg); margin: 32px 0 8px;
}
.doc-body h1 { font-size: 28px; line-height: 1.3; margin-top: 0; }
.doc-body h2 { font-size: 22px; line-height: 1.35; }
.doc-body h3 { font-size: 18px; line-height: 1.4; }
.doc-body :not(pre) > code { color: var(--accent); background: transparent; padding: 0 2px; }
/* Code stays mono all the way down. artificer.css sets the body face on
   every descendant of .surface-document and rescues only bare code/kbd, so
   chroma's token <span>s inside a <pre> fell back to the prose face and the
   columns of a highlighted block stopped lining up. Fixed upstream after
   Artificer 0.26.0 (docs/artificer-adaptations.md A6). */
.doc-body pre, .doc-body pre *, .doc-body code * { font-family: var(--font-mono); }
/* A document past the markup guard is shown as its source (markupguard.go);
   wrap it, since its lines can be a megabyte long. */
.doc-body pre.doc-plain-text { white-space: pre-wrap; overflow-wrap: anywhere; }
/* A plain quote: a quiet rule on the left. Callouts are blockquotes too and
   carry their own tier styling below. */
.doc-body blockquote:not(.callout) {
  margin: 16px 0; padding: 0 0 0 var(--s-md);
  border-left: 2px solid var(--border); color: var(--fg-secondary);
}

/* ── Properties frontmatter (render.go emits post-sanitizer, escaped fragments) ── */
.props {
  --props-tint: color-mix(in oklch, var(--bg-raised) 60%, transparent);
  background: var(--props-tint);
  border: 1px solid var(--border); border-radius: var(--radius-md);
  margin: 0 0 24px; font-family: var(--font-mono); font-size: 13px; overflow: hidden;
}
.props-row { display: flex; align-items: flex-start; gap: 12px; padding: 6px 12px; border-bottom: 1px solid var(--border); }
.props-row:last-child { border-bottom: none; }
.props-row .k { flex: 0 0 110px; display: flex; align-items: center; gap: 6px; color: var(--fg-secondary); font-size: 12px; padding-top: 3px; }
.props-row .k svg { color: var(--fg-disabled); flex-shrink: 0; width: 11px; height: 11px; stroke: currentColor; fill: none; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
.props-row .v { flex: 1; min-width: 0; color: var(--fg); display: flex; flex-wrap: wrap; gap: 4px; align-items: center; padding-top: 1px; }
/* Status chip: deliberately NOT Artificer's .chip, which is interactive
   (cursor: pointer, hover, and a 44px min-size under pointer: coarse). The
   value is a static label, so it gets none of that. */
.props-row .v .status-chip { display: inline-flex; align-items: center; padding: 2px 8px; border-radius: 4px; background: color-mix(in oklch, var(--accent-fill) 14%, transparent); color: var(--accent); font-size: 11px; border: 1px solid var(--border); font-family: var(--font-interface); font-weight: 500; white-space: nowrap; }
.props-row .v.dt { font-variant-numeric: tabular-nums; }
/* OKF trust badges (properties block + status bar). Deliberately NOT
   Artificer's .chip: that class is interactive (cursor, hover, aria-pressed,
   a 44px min-height under pointer: coarse), and a badge is a label. The text
   carries the meaning, so the tier colour is never the only signal. Colours
   are Artificer's solid .badge--attention / .badge--urgent pairs: the 14%
   tint the status chip uses left light-theme --attention text at 3.9:1 on
   the properties block, under AA for 11px text. */
.trust-badge { display: inline-flex; align-items: center; padding: 2px 8px; border-radius: 4px; font-size: 11px; line-height: 1.4; font-family: var(--font-mono); }
.trust-badge--stale { background: var(--attention-fill); color: var(--on-attention); }
.trust-badge--deprecated { background: var(--urgent-fill); color: var(--on-urgent); }

/* ── Callouts (GFM > [!NOTE] etc; tiers: note→accent, warning→attention, danger→urgent, tip→success) ── */
.callout { border-left: 2px solid var(--steel); background: color-mix(in oklch, var(--steel) 10%, transparent); padding: 12px 16px; border-radius: 0 var(--radius-md) var(--radius-md) 0; margin: 16px 0; }
/* Artificer's global .note (a footnote-scale label rule) also matches the
   note-tier class; restore the size and colour the other tiers inherit. */
.callout.note { --callout-tint: color-mix(in oklch, var(--accent) 8%, transparent); font-size: inherit; color: inherit; border-left-color: var(--accent); background: var(--callout-tint); }
.callout.warning { --callout-tint: color-mix(in oklch, var(--attention) 8%, transparent); border-left-color: var(--attention); background: var(--callout-tint); }
.callout.danger { --callout-tint: color-mix(in oklch, var(--urgent) 8%, transparent); border-left-color: var(--urgent); background: var(--callout-tint); }
.callout.tip { --callout-tint: color-mix(in oklch, var(--success) 8%, transparent); border-left-color: var(--success); background: var(--callout-tint); }
.callout-title { display: flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-weight: 700; font-size: 13px; letter-spacing: 0.04em; color: var(--accent); }
.callout.warning .callout-title { color: var(--attention); }
.callout.danger .callout-title { color: var(--urgent); }
.callout.tip .callout-title { color: var(--success); }
.callout-title svg { width: 14px; height: 14px; stroke: currentColor; fill: none; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
/* Body copy stays native <p> siblings of the title (blockquote semantics kept);
   these rules restate the reference's .callout-body treatment. */
.callout > p { color: var(--fg); margin: 6px 0 0; line-height: 1.6; font-size: 0.95em; }

/* ── Obsidian inline flavour (vault roots only: ==highlight==, #tag) ──
   .tag is deliberately not Artificer's .chip: that carries hover/pressed
   states and a 44px touch min-height that would break a line of prose. */
.doc-body mark { background: color-mix(in oklch, var(--attention) 28%, transparent); color: inherit; padding: 0 2px; border-radius: var(--radius-sm); }
.doc-body .tag { font-family: var(--font-mono); font-size: .85em; color: var(--accent); border: 1px solid var(--border); border-radius: 999px; padding: 0 6px; white-space: nowrap; unicode-bidi: isolate; }
/* A10: a [[wikilink]] that did not resolve. A span (no note) gets the help
   cursor for its hover reason; an anchor (note found, heading or block
   missing) keeps the pointer, since it still opens the note. */
.doc-body .wikilink-miss { color: var(--urgent-text); text-decoration: underline dashed; }
.doc-body span.wikilink-miss { cursor: help; }
/* A11: Artificer's `.surface-document *` sets the prose face on every KaTeX
   span, so digits and operators, which KaTeX leaves to inherit KaTeX_Main from
   .katex, drew in the body font. `.katex *` ties that specificity and wins by
   coming later, and still loses to KaTeX's own `.katex .mathnormal`-style
   rules, so the per-glyph faces KaTeX sets stay as they are. */
.katex * { font-family: inherit; }

/* ── Outline pane ── */
.outline { border-left: 1px solid var(--border); padding: var(--s-md) 0; font-family: var(--font-mono); overflow-y: auto; }
.outline-h { padding: var(--s-sm) 14px var(--s-xs); font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--fg-secondary); font-family: var(--font-interface); }
.outline-item { display: block; font-size: 12px; padding: 3px 14px; color: var(--fg-secondary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-decoration: none; }
.outline-item.h3 { padding-left: 28px; }
.outline-item:hover { color: var(--fg); }
/* Nav rows take the ring inside the row, like .sidenav: the outline pane
   scrolls, and a ring drawn outside the row was clipped at its edge. */
.outline-item:focus-visible { outline-offset: var(--focus-offset-inset); }
.outline-inline { display: none; margin: 0 0 var(--s-lg); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 6px 12px; font-family: var(--font-mono); font-size: 12px; }
.outline-inline summary { cursor: pointer; list-style: none; display: flex; align-items: center; gap: 8px; padding: 4px 0; font-family: var(--font-interface); font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--fg-secondary); }
.outline-inline summary::-webkit-details-marker { display: none; }
.outline-inline summary::after { content: ""; width: 6px; height: 6px; border-right: 1.5px solid var(--fg-secondary); border-bottom: 1.5px solid var(--fg-secondary); transform: rotate(45deg); transition: transform var(--dur-fast) var(--ease); }
.outline-inline summary:focus-visible { outline: var(--focus-width) solid var(--accent); outline-offset: var(--focus-offset); border-radius: var(--radius-sm); }
.outline-inline[open] summary::after { transform: rotate(-135deg); }
.outline-inline .outline-item { padding: 3px 0; }
.outline-inline .outline-item.h3 { padding-left: 14px; }

/* ── Status bar ── */
.statusbar { display: flex; align-items: stretch; border-top: 1px solid var(--border); background: var(--bg); font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: 11px; color: var(--fg-secondary); }
.status-item { padding: 5px 12px; display: flex; align-items: center; gap: 6px; border-right: 1px solid var(--border); }
.status-item:last-child { border-right: none; }
.status-item.words { white-space: nowrap; }
.status-spacer { flex: 1; }
.live-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--success); }
/* reload.js sets this when the live-reload stream gives up. The text changes
   with it, so the tier never rides on color alone. */
.live-dot--down { background: var(--attention-fill); }
.doc-body > .banner { margin: 0 0 var(--s-lg); }

/* ── Embeds ── */
.embed { border: 1px solid var(--border); border-radius: var(--radius-md); background: color-mix(in oklch, var(--bg-raised) 50%, transparent); margin: 16px 0; overflow: hidden; }
.embed-bar { display: flex; align-items: center; gap: 8px; padding: 4px 10px; border-bottom: 1px solid var(--border); font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--fg-disabled); }
.embed-bar .spacer { flex: 1; }
.embed-bar button { background: none; border: 0; color: var(--fg-secondary); font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer; padding: 2px 6px; border-radius: var(--radius-sm); }
.embed-bar button:hover { color: var(--fg); background: var(--bg-raised); }
.embed-body { padding: 16px; display: flex; justify-content: center; overflow: hidden; }
.embed-body svg { max-width: 100%; height: auto; }
/* mermaid theming onto Artificer tokens — the base theme is configured from
   these same tokens in mermaid-init.js; the rules below also catch mermaid's
   emitted classes directly. */
.mm-node, .embed-body .node rect { fill: color-mix(in oklch, var(--accent-fill) 12%, var(--bg-raised)); stroke: var(--accent); stroke-width: 1; }
.mm-node-alt { fill: color-mix(in oklch, var(--steel) 14%, var(--bg-raised)); stroke: var(--steel); stroke-width: 1; }
.mm-label, .embed-body .nodeLabel { fill: var(--fg); color: var(--fg); font-family: var(--font-mono); font-size: 12px; }
.mm-edge, .embed-body .edgePath path { stroke: var(--fg-disabled); stroke-width: 1.2; fill: none; }
.mm-arrow { fill: var(--fg-disabled); }
.mm-edge-label, .embed-body .edgeLabel { fill: var(--fg-secondary); color: var(--fg-secondary); font-family: var(--font-mono); font-size: 10px; }
.doc-body figure { margin: 16px 0; }
.doc-body figure img, .doc-body > img, .doc-body p > img { max-width: 100%; border-radius: var(--radius-md); border: 1px solid var(--border); display: block; }
.doc-body figcaption { font-family: var(--font-mono); font-size: 11px; color: var(--fg-secondary); margin-top: 6px; }
/* Collapsibles an author writes as raw <details>: Artificer's .accordion
   treatment, restated for bare markup since the author never adds the class. */
.doc-body details { border: 1px solid var(--border); border-radius: var(--radius-md); margin: 16px 0; }
.doc-body details > summary {
  display: flex; align-items: center; justify-content: space-between; gap: var(--s-sm);
  padding: var(--s-sm) var(--s-md); cursor: pointer; list-style: none; font-weight: 500;
}
.doc-body details > summary::-webkit-details-marker { display: none; }
.doc-body details > summary::after {
  content: ""; flex: none; width: 7px; height: 7px;
  border-right: 1.5px solid var(--fg-secondary); border-bottom: 1.5px solid var(--fg-secondary);
  transform: rotate(45deg); transition: transform var(--dur-fast) var(--ease);
}
.doc-body details[open] > summary::after { transform: rotate(-135deg); }
.doc-body details > summary:focus-visible { outline: var(--focus-width) solid var(--accent); outline-offset: var(--focus-offset-inset); }
.doc-body details > :not(summary) { margin-left: var(--s-md); margin-right: var(--s-md); }
/* Task lists: goldmark emits no wrapper class, so :has() selects the shape. */
.doc-body ul:has(> li > input[type="checkbox"]) { list-style: none; padding-left: 4px; }
.doc-body li:has(> input[type="checkbox"]) { display: flex; align-items: baseline; gap: 8px; }
.doc-body input[type="checkbox"] { accent-color: var(--accent); transform: translateY(1px); }

/* ── Layout: grid + narrow screens ── */
[data-fc="shell"] { height: 100vh; display: flex; flex-direction: column; background: var(--bg); }
.nav-toggle { display: flex; align-items: center; justify-content: center; width: 32px; height: 32px; background: none; border: 0; border-radius: var(--radius-sm); color: var(--fg-secondary); cursor: pointer; flex: none; }
.nav-toggle:hover { color: var(--fg); background: var(--bg-raised); }
.nav-toggle svg { width: 16px; height: 16px; stroke: currentColor; fill: none; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
.content-grid { flex: 1; min-height: 0; display: grid; grid-template-columns: 280px minmax(0, 1fr) 220px; }
.content-grid--no-outline { grid-template-columns: 280px minmax(0, 1fr); }
.docs-nav { display: flex; flex-direction: column; min-height: 0; border-right: 1px solid var(--border); background: var(--bg-raised); }
.docs-nav .search { margin: var(--s-sm) var(--s-sm) 0; }
.docs-nav .search svg { width: 14px; height: 14px; stroke: currentColor; fill: none; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
.docs-nav .search > input { padding: 6px 0; font-size: 13px; }
/* One ring: the .search border already turns --accent on focus. Fixed
   upstream in Artificer after 0.26.0; drop this once the vendored copy has it
   (docs/artificer-adaptations.md A6). */
.docs-nav .search > input:focus-visible { outline: none; }

/* ── Landing page ── */
.home h1 { margin-bottom: 0; }
.doc-body .empty-state__title { margin: 0; font-size: var(--t-body-lg-size); color: var(--fg); }
.sidenav-empty { margin: var(--s-sm) var(--s-md) 0; color: var(--fg-secondary); }
.home .table { width: 100%; }
/* The doc title is the row header (it becomes the card header when the
   table reflows under 640px), but it reads as a link, not a column label. */
.home .table tbody th { font-family: inherit; font-size: inherit; font-weight: 500; letter-spacing: normal; text-transform: none; }
.home .table a { text-decoration: none; }
.home .table .path { color: var(--fg-secondary); font-family: var(--font-mono); font-size: 13px; overflow-wrap: anywhere; }
.home .table .num { white-space: nowrap; }
.docs-nav .sidenav { border-radius: 0; border: 0; flex: 1; overflow-y: auto; }
main.surface-document { padding: var(--s-xl); overflow-y: auto; min-height: 0; }
/* The doc pane is the containing block, and the paint clip, for everything a
   doc renders (forgectl#745). A doc can wear Artificer's position:absolute
   classes (.tooltip is z-index 1000, white-space: nowrap), and with no
   positioned ancestor they anchored to the page: a .tooltip--bottom sat under
   the status bar and made the whole page scroll, a long .tooltip ran across
   the outline column. contain: paint also contains position:fixed. It sits
   on <main>, the pane's scroll container, not on .doc-body: clipping
   .doc-body cut off wide tables and display math that scroll <main>
   sideways today. Sticky table heads and the pan/zoom viewport are
   unchanged (measured). */
main.surface-document { position: relative; contain: paint; }
/* Four pieces of chrome live inside the doc pane, so that clip cannot keep a
   doc off them (forgectl#759): the narrow-width outline, the skip-content
   banner and the properties block (render.go puts both above the doc), and
   the missing-doc banner (reload.js prepends it). A doc's .tooltip (z-index
   var(--z-popover)) anchored to a positioned wrapper just below any of them
   (.phase, .has-tooltip, .grain) painted over it. Each gets its own
   stacking context one step above --z-popover, and an opaque base under its
   tint so nothing shows through; the missing-doc banner's background is
   already opaque (.banner--attention mixes into --bg-raised). The two
   data attributes are the server's own, never a doc's: the sanitizer strips
   every data-* attribute from a doc, and mermaid-init.js scrubs them from
   rendered diagrams. A fifth reader-injected element, the mermaid .embed
   card (mermaid-init.js wrapEmbeds), is deliberately NOT elevated: it wraps
   the doc's own diagram in the doc's flow, so it stacks as doc content, and
   a doc tooltip over its bar spoofs nothing but a "reset" button. */
.outline-inline, [data-forgectl-notice], [data-forgectl-props], [data-fc="doc-missing"] { position: relative; z-index: calc(var(--z-popover) + 1); isolation: isolate; }
.outline-inline { background: var(--bg); }
[data-forgectl-notice].callout.warning { background: linear-gradient(var(--callout-tint), var(--callout-tint)), var(--bg); }
.props[data-forgectl-props] { background: linear-gradient(var(--props-tint), var(--props-tint)), var(--bg); }
/* The document pane scrolls, so with no link in view the browser makes the
   pane itself the keyboard stop. Give it the house ring, inset so the grid's
   edges don't clip it. */
main.surface-document:focus-visible { outline: var(--focus-width) solid var(--accent); outline-offset: var(--focus-offset-inset); }
[data-fc="drawer-scrim"] { display: none; }
@media (min-width: 901px) {
  [data-nav="closed"] .docs-nav { display: none; }
  [data-nav="closed"] .content-grid { grid-template-columns: minmax(0, 1fr) 220px; }
  [data-nav="closed"] .content-grid--no-outline { grid-template-columns: minmax(0, 1fr); }
}
@media (max-width: 1100px) {
  .outline { display: none; }
  .outline-inline { display: block; }
  .content-grid, .content-grid--no-outline,
  [data-nav="closed"] .content-grid { grid-template-columns: 280px minmax(0, 1fr); }
  [data-nav="closed"] .content-grid, [data-nav="closed"] .content-grid--no-outline { grid-template-columns: minmax(0, 1fr); }
}
@media (max-width: 900px) {
  .content-grid, .content-grid--no-outline, [data-nav="closed"] .content-grid { grid-template-columns: minmax(0, 1fr); }
  .docs-nav {
    position: fixed; top: 0; bottom: 0; left: 0; width: min(300px, 85vw); z-index: var(--z-modal);
    background: var(--bg-raised);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    transform: translateX(-100%); transition: transform 200ms var(--ease);
  }
  [data-nav="open"] .docs-nav { transform: none; }
  [data-nav="open"] [data-fc="drawer-scrim"] { display: block; position: fixed; inset: 0; background: rgba(0, 0, 0, 0.55); z-index: var(--z-overlay); }
  main.surface-document { padding: var(--s-md); }
}
@media (prefers-reduced-motion: reduce) { .docs-nav { transition: none; } }
@media (max-width: 640px) {
  .status-item.opt { display: none; }
}
/* One line at phone width. A stale or deprecated badge beside "serving · host:port"
   wrapped the bar to ~45px at 375px. Drop the host (the title tooltip keeps the
   full text) and forbid wrapping. */
.live-status, .live-status__text { white-space: nowrap; }
/* The disconnected message is long; let it ellipsize (its title carries it all)
   rather than push the bar wider than the viewport. */
.live-status { min-width: 0; }
.live-status__text { overflow: hidden; text-overflow: ellipsis; }
@media (max-width: 480px) {
  .live-status__host { display: none; }
}
</style>
<script src="/assets/artificer-theme.js" defer></script>
<script src="/assets/reload.js" defer></script>
<script src="/assets/artificer-tree.js" defer></script>
<script src="/assets/sidenav-filter.js" defer></script>
<script src="/assets/nav-toggle.js" defer></script>
<script src="/assets/copy.js" defer></script>
<!-- mermaid must be parsed before its init script runs; both are deferred, and
     deferred scripts execute in document order, so this ordering is the
     dependency declaration. -->
<script src="/assets/mermaid.min.js" defer></script>
<script src="/assets/mermaid-init.js" defer></script>
<script src="/assets/svg-panzoom.js" defer></script>
<!-- Same ordering rule for KaTeX and its init script. -->
<script src="/assets/katex/katex.min.js" defer></script>
<script src="/assets/math-init.js" defer></script>
</head>
<body>
<a class="skip-link" href="#doc-main">Skip to content</a>
<div id="shell" data-fc="shell" class="surface-tool" data-nav="auto">
  <header class="appbar appbar--static" style="flex: none">
    <button class="nav-toggle" id="nav-toggle" data-fc="nav-toggle" aria-label="Toggle sidebar" aria-expanded="true" aria-controls="docs-nav"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9 4v16"/></svg></button>
    <a class="appbar__brand wordmark" href="/">forgectl docs</a>
    <div class="appbar__spacer"></div>
    <div class="appbar__actions">
      <button class="theme-toggle" data-theme-toggle aria-label="Toggle theme"></button>
    </div>
  </header>
  <div class="content-grid{{if not .Outline}} content-grid--no-outline{{end}}">
    <div id="drawer-scrim" data-fc="drawer-scrim"></div>
    <aside class="docs-nav" id="docs-nav" data-fc="docs-nav">
      <div class="search">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <label class="sr-only" for="doc-filter">Filter docs</label>
        <input id="doc-filter" data-fc="doc-filter" type="search" placeholder="Filter docs…" autocomplete="off"/>
      </div>
      <p class="note sidenav-empty" id="filter-empty" data-fc="filter-empty" role="status" hidden></p>
      <nav class="sidenav" data-fc="sidenav" aria-label="Indexed docs">
        {{range .Groups}}
        <div class="sidenav__group">{{.Root}}</div>
        {{if .Tree}}
        <ul class="tree tree--static" aria-label="{{.Root}}">{{template "treeNodes" .Tree}}</ul>
        {{else}}
        {{range .Docs}}
        <a href="{{.Href}}" title="{{.Title}}" data-filter-text="{{.FilterText}}"><span class="label">{{.Title}}</span></a>
        {{end}}
        {{end}}
        {{end}}
      </nav>
    </aside>
    <main id="doc-main" class="surface-document container container--lg" data-fc="doc-main">
      {{if .Outline}}
      <details class="outline-inline" data-fc="outline-inline"><summary>On this page</summary><nav aria-label="On this page">{{template "outlineItems" .Outline}}</nav></details>
      {{end}}
      <div class="doc-body" data-fc="doc-body">
      {{if .Content}}{{.Content}}{{else if .Home}}{{if .Home.Recent}}
      <div class="home">
        <h1>Indexed docs</h1>
        <p class="meta">{{.DocCount}} {{if eq .DocCount 1}}doc{{else}}docs{{end}} across {{len .Home.Roots}} {{if eq (len .Home.Roots) 1}}root{{else}}roots{{end}}. Pick one from the sidebar, or start with a recent change.</p>
        <h2>Recently changed</h2>
        <table class="table table--responsive">
          <thead><tr><th scope="col">Doc</th><th scope="col">Path</th><th scope="col" class="num">Modified</th></tr></thead>
          <tbody>
          {{range .Home.Recent}}<tr><th scope="row"><a href="{{.Href}}">{{.Title}}</a></th><td><span class="path">{{.Path}}</span></td><td class="num" data-label="Modified">{{.Modified}}</td></tr>
          {{end}}</tbody>
        </table>
        <h2>Roots</h2>
        <dl class="kv">
          {{range .Home.Roots}}<dt>{{.Label}}</dt><dd class="num">{{.Count}} {{if eq .Count 1}}doc{{else}}docs{{end}}</dd>
          {{end}}</dl>
      </div>
      {{else}}
      <div class="empty-state">
        <h1 class="empty-state__title">No docs indexed</h1>
        <p class="empty-state__body">forgectl found no markdown files in the directories it is serving. Add a <code>.md</code> file there and this page updates on its own, or restart <code>forgectl docs serve</code> with a different directory.</p>
      </div>
      {{end}}{{end}}
      </div>
    </main>
    {{if .Outline}}
    <aside class="outline" data-fc="outline" aria-label="On this page">
      <div class="outline-h">On this page</div>
      {{template "outlineItems" .Outline}}
    </aside>
    {{end}}
  </div>
  <footer class="statusbar" data-fc="statusbar" style="flex: none">
    <div class="status-item live-status" id="live-status" data-fc="live-status" role="status" title="serving · {{.Host}}"><span class="live-dot" aria-hidden="true"></span><span class="live-status__text">serving<span class="live-status__host"> · {{.Host}}</span></span></div>
    {{if .DocPath}}<div class="status-item opt">{{.DocPath}}</div>{{end}}
    {{if .Trust.Deprecated}}<div class="status-item"><span class="trust-badge trust-badge--deprecated">deprecated</span></div>{{end}}
    {{if .Trust.Stale}}<div class="status-item"><span class="trust-badge trust-badge--stale" title="stale since {{.Trust.StaleAfter}}">stale</span></div>{{end}}
    <div class="status-spacer"></div>
    <div class="status-item opt">{{.DocCount}} {{if eq .DocCount 1}}doc{{else}}docs{{end}} indexed</div>
    {{if .Words}}<div class="status-item words">{{.Words}} words · {{.Minutes}} min</div>{{end}}
  </footer>
</div>
</body>
</html>
{{define "outlineItems"}}{{range .}}<a class="outline-item h{{.Level}}" href="#{{.ID}}">{{.Text}}</a>{{end}}{{end}}
{{define "treeNodes"}}{{range .}}<li>{{if .Leaf}}<a class="tree__row tree__leaf" href="{{.Leaf.Href}}" title="{{.Leaf.Title}}" data-filter-text="{{.Leaf.FilterText}}"{{if .Leaf.Current}} aria-current="page"{{end}}><span class="tree__twisty" aria-hidden="true"></span><span class="label">{{.Leaf.Title}}</span></a>{{else}}<details{{if .Open}} open{{end}}><summary class="tree__row"><span class="tree__twisty" aria-hidden="true"></span><span class="label">{{.Name}}</span> <span class="count">{{.Count}}</span></summary><ul class="tree__group">{{template "treeNodes" .Children}}</ul></details>{{end}}</li>{{end}}{{end}}
