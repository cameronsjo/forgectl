<!doctype html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>{{if .DocTitle}}{{.DocTitle}} · {{end}}forgectl docs</title>
<link rel="stylesheet" href="/assets/artificer.css"/>
<link rel="stylesheet" href="/assets/chroma.css"/>
<link rel="stylesheet" href="/assets/diagram.css"/>
<script src="/assets/artificer-theme.js" defer></script>
<script src="/assets/reload.js" defer></script>
<script src="/assets/artificer-tree.js" defer></script>
<script src="/assets/sidenav-filter.js" defer></script>
<!-- mermaid must be parsed before its init script runs; both are deferred, and
     deferred scripts execute in document order, so this ordering is the
     dependency declaration. -->
<script src="/assets/mermaid.min.js" defer></script>
<script src="/assets/mermaid-init.js" defer></script>
<script src="/assets/svg-panzoom.js" defer></script>
</head>
<body class="surface-tool">
<div class="page-shell">
  <header class="appbar">
    <a class="appbar__brand wordmark" href="/">forgectl docs</a>
    <div class="appbar__spacer"></div>
    <div class="appbar__actions">
      <button class="theme-toggle" data-theme-toggle aria-label="Toggle theme"></button>
    </div>
  </header>
  <div class="split-pane" style="gap:0;min-height:calc(100vh - 52px)">
    <aside style="border-right:1px solid var(--border);display:flex;flex-direction:column">
      <div class="field" style="padding:var(--s-sm)">
        <label class="field__label" for="doc-filter">Filter</label>
        <input class="input" id="doc-filter" type="search" placeholder="Filter docs…" autocomplete="off"/>
      </div>
      <nav class="sidenav" aria-label="Indexed docs" style="border-radius:0;border:0;flex:1;overflow-y:auto">
        {{range .Groups}}
        <div class="sidenav__group">{{.Root}}</div>
        {{if .Tree}}
        <ul class="tree tree--static" aria-label="{{.Root}}">{{template "treeNodes" .Tree}}</ul>
        {{else}}
        {{range .Docs}}
        <a href="{{.Href}}" data-filter-text="{{.FilterText}}"{{if .Current}} aria-current="page"{{end}}><span class="label">{{.Title}}</span></a>
        {{end}}
        {{end}}
        {{end}}
      </nav>
    </aside>
    <main class="surface-document container container--lg" style="padding:var(--s-xl)">
      {{if .Content}}{{.Content}}{{else}}
      <div class="empty-state">
        <h2>No doc selected</h2>
        <p>Choose a document from the sidebar to start reading.</p>
      </div>
      {{end}}
    </main>
  </div>
</div>
</body>
</html>
{{define "treeNodes"}}{{range .}}<li>{{if .Leaf}}<a class="tree__row tree__leaf" href="{{.Leaf.Href}}" data-filter-text="{{.Leaf.FilterText}}"{{if .Leaf.Current}} aria-current="page"{{end}}><span class="tree__twisty" aria-hidden="true"></span><span class="label">{{.Leaf.Title}}</span></a>{{else}}<details{{if .Open}} open{{end}}><summary class="tree__row"><span class="tree__twisty" aria-hidden="true"></span><span class="label">{{.Name}}</span> <span class="count">{{.Count}}</span></summary><ul class="tree__group">{{template "treeNodes" .Children}}</ul></details>{{end}}</li>{{end}}{{end}}
