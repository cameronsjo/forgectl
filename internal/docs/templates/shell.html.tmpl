<!doctype html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>{{if .DocTitle}}{{.DocTitle}} · {{end}}forgectl docs</title>
<link rel="stylesheet" href="/assets/artificer.css"/>
<link rel="stylesheet" href="/assets/chroma.css"/>
<link rel="stylesheet" href="/assets/diagram.css"/>
<style>
  /* Docs-reader-v2 shell (docs/plans/2026-09-01-docs-reader-v2.md). Inline
     <style> is fine under the CSP (style-src carries 'unsafe-inline'). */

  /* ── Layout: grid, three breakpoints ─────────────────────────────── */
  .reader {
    display: grid;
    grid-template-columns: 280px minmax(0,1fr) 220px;
    min-height: calc(100vh - 52px - 29px);
  }
  .reader--no-outline { grid-template-columns: 280px minmax(0,1fr); }
  .reader__nav { border-right: 1px solid var(--border); display: flex; flex-direction: column; }
  .reader__doc { padding: var(--s-xl); }
  .reader__outline {
    border-left: 1px solid var(--border); padding: var(--s-lg) var(--s-md);
    font-family: var(--font-mono); font-size: 12px;
  }
  .outline-inline { display: none; }
  .nav-scrim { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.55); z-index: var(--z-overlay); }

  /* Wide: the toggle collapses the nav column. */
  .page-shell[data-nav="closed"] .reader { grid-template-columns: minmax(0,1fr) 220px; }
  .page-shell[data-nav="closed"] .reader--no-outline { grid-template-columns: minmax(0,1fr); }
  .page-shell[data-nav="closed"] .reader__nav { display: none; }

  @media (max-width: 1100px) {
    .reader, .reader--no-outline { grid-template-columns: 280px minmax(0,1fr); }
    .page-shell[data-nav="closed"] .reader,
    .page-shell[data-nav="closed"] .reader--no-outline { grid-template-columns: minmax(0,1fr); }
    .reader__outline { display: none; }
    .outline-inline { display: block; margin: 0 0 var(--s-lg); }
  }
  @media (max-width: 900px) {
    .reader, .reader--no-outline { grid-template-columns: minmax(0,1fr); }
    .reader__nav {
      position: fixed; top: 0; bottom: 0; left: 0; z-index: var(--z-modal);
      width: min(300px, 85vw); background: var(--bg-raised);
      box-shadow: 0 0 24px rgba(0,0,0,.4);
      transform: translateX(-100%); transition: transform 200ms var(--ease);
      display: flex;
    }
    .page-shell[data-nav="open"] .reader__nav { transform: none; }
    .page-shell[data-nav="open"] .nav-scrim { display: block; }
    .page-shell[data-nav="closed"] .reader__nav { display: flex; }
  }
  @media (prefers-reduced-motion: reduce) { .reader__nav { transition: none; } }

  /* ── Sidenav density: the 24px Obsidian verdict ──────────────────── */
  .sidenav .tree__row { min-height: 24px; font-size: 13px; }
  .sidenav a.tree__row { min-height: 24px; }
  .sidenav > a { min-height: 24px; font-size: 13px; }
  .sidenav > a, .sidenav > .sidenav__group, .sidenav > ul { flex: none; }
  .tree--static details[open] > summary > .tree__twisty { transform: rotate(90deg); }
  .tree--static summary > .count {
    margin-left: auto; font-variant-numeric: tabular-nums;
    font-size: var(--t-label-sm-size); color: var(--fg-disabled);
  }

  /* ── Note typography for the document pane ───────────────────────── */
  .reader__doc { max-width: 820px; }
  .reader__doc p, .reader__doc li {
    font-size: 16px; line-height: 1.65;
    letter-spacing: 0.01em; word-spacing: 0.12em;
  }
  .reader__doc h1, .reader__doc h2, .reader__doc h3 {
    font-family: var(--font-mono); font-weight: 700; color: var(--accent);
    letter-spacing: -0.01em; margin: 32px 0 8px;
  }
  .reader__doc h1 { font-size: 28px; margin-top: 0; }
  .reader__doc h2 { font-size: 22px; }
  .reader__doc h3 { font-size: 18px; }
  .reader__doc :not(pre) > code { color: var(--accent); background: transparent; }

  /* ── Frontmatter properties block ────────────────────────────────── */
  .props {
    background: color-mix(in oklch, var(--bg-raised) 60%, transparent);
    border: 1px solid var(--border); border-radius: var(--radius-md);
    font-family: var(--font-mono); font-size: 13px;
    margin: 0 0 var(--s-lg);
  }
  .props-row { display: flex; align-items: baseline; gap: var(--s-sm); padding: 6px 12px; }
  .props-row + .props-row { border-top: 1px solid var(--border); }
  .props .k {
    flex: 0 0 110px; font-size: 12px; color: var(--fg-secondary);
    display: inline-flex; align-items: center; gap: 6px;
  }
  .props .v { min-width: 0; overflow-wrap: anywhere; }
  .props .num { font-variant-numeric: tabular-nums; }
  .chip {
    display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 11px;
    background: color-mix(in oklch, var(--accent-fill) 14%, transparent);
    color: var(--accent);
  }

  /* ── Callouts ────────────────────────────────────────────────────── */
  .callout {
    border-left: 2px solid var(--accent);
    background: color-mix(in oklch, var(--accent) 8%, transparent);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    padding: var(--s-sm) var(--s-md); margin: var(--s-md) 0;
  }
  .callout__title {
    font-family: var(--font-mono); font-weight: 700; font-size: 13px;
    display: flex; align-items: center; gap: 6px;
    color: var(--accent); margin: 0 0 4px;
  }
  .callout--tip { border-left-color: var(--success); background: color-mix(in oklch, var(--success) 8%, transparent); }
  .callout--tip .callout__title { color: var(--success); }
  .callout--warning { border-left-color: var(--attention); background: color-mix(in oklch, var(--attention) 10%, transparent); }
  .callout--warning .callout__title { color: var(--attention); }
  .callout--danger { border-left-color: var(--urgent); background: color-mix(in oklch, var(--urgent) 10%, transparent); }
  .callout--danger .callout__title { color: var(--urgent); }

  /* ── Outline ─────────────────────────────────────────────────────── */
  .outline__title { color: var(--fg-secondary); text-transform: uppercase; font-size: 10px; letter-spacing: .08em; margin-bottom: var(--s-sm); }
  .outline__item { display: block; padding: 3px 0; color: var(--fg-secondary); text-decoration: none; }
  .outline__item:hover { color: var(--fg); }
  .outline__item--h3 { padding-left: 14px; }
  .outline-inline > summary { font-family: var(--font-mono); font-size: 13px; cursor: pointer; color: var(--fg-secondary); }
  .outline-inline nav { padding: var(--s-sm) 0 0 var(--s-md); font-family: var(--font-mono); font-size: 12px; }

  /* ── Status bar ──────────────────────────────────────────────────── */
  .statusbar {
    display: flex; align-items: center; gap: var(--s-md);
    border-top: 1px solid var(--border); padding: 5px var(--s-md);
    font-family: var(--font-mono); font-size: 11px;
    font-variant-numeric: tabular-nums; color: var(--fg-secondary);
  }
  .statusbar__item { display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; }
  .statusbar__spacer { flex: 1; }
  @media (max-width: 640px) { .statusbar .opt { display: none; } }

  /* ── Embeds, figures, task lists ─────────────────────────────────── */
  .embed { border: 1px solid var(--border); border-radius: var(--radius-md); margin: var(--s-md) 0; overflow: hidden; }
  .embed-bar {
    display: flex; align-items: center; justify-content: space-between;
    font-family: var(--font-mono); font-size: 10px; text-transform: uppercase;
    letter-spacing: .08em; color: var(--fg-secondary);
    padding: 4px 10px; border-bottom: 1px solid var(--border);
    background: color-mix(in oklch, var(--bg-raised) 60%, transparent);
  }
  .embed-bar button { font: inherit; color: inherit; background: none; border: 0; cursor: pointer; }
  .embed-bar button:hover { color: var(--fg); }
  .embed-body { display: flex; justify-content: center; padding: var(--s-md); }
  .reader__doc img { border-radius: var(--radius-md); border: 1px solid var(--border); max-width: 100%; }
  .reader__doc figcaption { font-family: var(--font-mono); font-size: 11px; color: var(--fg-secondary); margin-top: 4px; }
  .reader__doc ul:has(> li > input[type="checkbox"]) { list-style: none; padding-left: 0; }
  .reader__doc li:has(> input[type="checkbox"]) { display: flex; align-items: baseline; gap: 8px; }
  .reader__doc input[type="checkbox"] { accent-color: var(--accent); }

  .nav-toggle { width: 32px; height: 32px; margin-right: var(--s-sm); }
</style>
<script src="/assets/artificer-theme.js" defer></script>
<script src="/assets/reload.js" defer></script>
<script src="/assets/artificer-tree.js" defer></script>
<script src="/assets/sidenav-filter.js" defer></script>
<script src="/assets/nav-toggle.js" defer></script>
<!-- mermaid must be parsed before its init script runs; both are deferred, and
     deferred scripts execute in document order, so this ordering is the
     dependency declaration. -->
<script src="/assets/mermaid.min.js" defer></script>
<script src="/assets/mermaid-init.js" defer></script>
<script src="/assets/svg-panzoom.js" defer></script>
</head>
<body class="surface-tool">
<div class="page-shell" data-nav="auto">
  <header class="appbar">
    <button class="btn btn--icon nav-toggle" data-nav-toggle aria-label="Toggle navigation" aria-expanded="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M9 3v18"/></svg></button>
    <a class="appbar__brand wordmark" href="/">forgectl docs</a>
    <div class="appbar__spacer"></div>
    <div class="appbar__actions">
      <button class="theme-toggle" data-theme-toggle aria-label="Toggle theme"></button>
    </div>
  </header>
  <div class="reader{{if not .Outline}} reader--no-outline{{end}}">
    <aside class="reader__nav">
      <div class="field" style="padding:var(--s-sm)">
        <label class="field__label" for="doc-filter">Filter</label>
        <input class="input" id="doc-filter" type="search" placeholder="Filter docs…" autocomplete="off"/>
      </div>
      <nav class="sidenav" aria-label="Indexed docs" style="border-radius:0;border:0;flex:1;overflow-y:auto">
        {{range .Groups}}
        <div class="sidenav__group">{{.Root}}</div>
        {{if .Tree}}
        <ul class="tree tree--static" aria-label="{{.Root}}">{{template "treeNodes" .Tree}}</ul>
        {{else}}
        {{range .Docs}}
        <a href="{{.Href}}" data-filter-text="{{.FilterText}}"><span class="label">{{.Title}}</span></a>
        {{end}}
        {{end}}
        {{end}}
      </nav>
    </aside>
    <div class="nav-scrim" data-nav-scrim></div>
    <main class="reader__doc surface-document">
      {{if .Outline}}
      <details class="outline-inline"><summary>On this page</summary><nav aria-label="On this page">{{template "outlineItems" .Outline}}</nav></details>
      {{end}}
      {{if .Content}}{{.Content}}{{else}}
      <div class="empty-state">
        <h2>No doc selected</h2>
        <p>Choose a document from the sidebar to start reading.</p>
      </div>
      {{end}}
    </main>
    {{if .Outline}}
    <nav class="reader__outline" aria-label="On this page">
      <div class="outline__title">On this page</div>
      {{template "outlineItems" .Outline}}
    </nav>
    {{end}}
  </div>
  <footer class="statusbar">
    <span class="statusbar__item opt"><span class="dot dot--success" aria-hidden="true"></span>serving · {{.Host}}</span>
    {{if .DocPath}}<span class="statusbar__item opt">{{.DocPath}}</span>{{end}}
    <span class="statusbar__spacer"></span>
    <span class="statusbar__item opt">{{.DocCount}} docs</span>
    {{if .Words}}<span class="statusbar__item">{{.Words}} words · {{.Minutes}} min</span>{{end}}
    <span class="statusbar__item opt">markdown</span>
  </footer>
</div>
</body>
</html>
{{define "outlineItems"}}{{range .}}<a class="outline__item outline__item--h{{.Level}}" href="#{{.ID}}">{{.Text}}</a>{{end}}{{end}}
{{define "treeNodes"}}{{range .}}<li>{{if .Leaf}}<a class="tree__row tree__leaf" href="{{.Leaf.Href}}" data-filter-text="{{.Leaf.FilterText}}"{{if .Leaf.Current}} aria-current="page"{{end}}><span class="tree__twisty" aria-hidden="true"></span><span class="label">{{.Leaf.Title}}</span></a>{{else}}<details{{if .Open}} open{{end}}><summary class="tree__row"><span class="tree__twisty" aria-hidden="true"></span><span class="label">{{.Name}}</span> <span class="count">{{.Count}}</span></summary><ul class="tree__group">{{template "treeNodes" .Children}}</ul></details>{{end}}</li>{{end}}{{end}}
